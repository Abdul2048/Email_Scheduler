generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  DEFERRED
  SENDING
  SENT
  FAILED
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns        Campaign[]
  emails           Email[]
  slackIntegration SlackIntegration?
}

model Sender {
  id        String   @id @default(uuid())
  email     String   @unique
  smtpHost  String
  smtpPort  Int
  smtpUser  String
  smtpPass  String
  createdAt DateTime @default(now())

  emails Email[]
}

model Campaign {
  id          String   @id @default(uuid())
  userId      String
  subject     String
  body        String
  startAt     DateTime
  delayMs     Int
  hourlyLimit Int
  totalCount  Int
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId, createdAt])
}

model Email {
  id          String      @id @default(uuid())
  campaignId  String
  userId      String
  senderId    String
  toEmail     String
  subject     String
  status      EmailStatus @default(SCHEDULED)
  scheduledAt DateTime
  sentAt      DateTime?
  previewUrl  String?
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id])

  @@unique([campaignId, toEmail])
  @@index([userId, status, scheduledAt])
  @@index([userId, status, updatedAt])
  @@index([status, scheduledAt])
}

model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String   @unique
  webhookUrl  String
  teamName    String
  channelName String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
