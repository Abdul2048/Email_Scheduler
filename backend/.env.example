# Browser origin (Vite dev server over HTTPS). OAuth redirect URIs are built from this:
#   Google: ${APP_URL}/api/auth/google/callback
#   Slack:  ${APP_URL}/api/integrations/slack/callback
APP_URL=https://localhost:5173
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://app:app@localhost:5432/scheduler
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Any long random string (>= 32 chars). Signs the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [api.slack.com/apps](http://api.slack.com/apps) -> your app -> Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Email sending
SENDER_COUNT=3
EMAIL_TRANSPORT=ethereal

# Throughput & rate limiting
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
