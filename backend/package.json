{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "tsx watch --clear-screen=false src/server.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "setup": "prisma migrate deploy && prisma generate && npm run seed",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "load-test": "tsx scripts/load-test.ts",
    "test:regression": "tsx scripts/regression.ts",
    "es:reindex": "tsx scripts/es-reindex.ts"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.2",
    "@bull-board/express": "^9.10.2",
    "@elastic/elasticsearch": "^8.19.2",
    "@prisma/client": "^6.19.0",
    "bullmq": "^6.3.10",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.12",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
